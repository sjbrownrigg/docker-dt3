# Copy to .env. Never commit .env.
NAS_ADDR=192.168.1.240
DISCOGS_USER_TOKEN=
PUID=1000
PGID=1000
TZ=Europe/London

# WSL2 fallback, used only with compose.wsl.yaml.
# discogstagger3 writes, so these must be writable -- unlike mozarr's
# read-only library mount. See the note in compose.wsl.yaml.
INCOMING_DIR=/mnt/nas/music/incoming
SORTED_DIR=/mnt/nas/music/sorted
